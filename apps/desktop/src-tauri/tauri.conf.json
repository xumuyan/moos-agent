{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moos",
  "version": "0.1.0",
  "identifier": "dev.moos.agent",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Moos",
        "width": 1280,
        "height": 820,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src blob:; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "capabilities": [
        {
          "identifier": "main-window-chrome",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:window:allow-start-dragging"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/moos-v1/32x32.png",
      "icons/moos-v1/128x128.png",
      "icons/moos-v1/128x128@2x.png",
      "icons/moos-v1/icon.icns",
      "icons/moos-v1/icon.ico"
    ],
    "targets": [
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../../services/agent/": "services/agent/",
      "../../../packages/pi-adapter/": "packages/pi-adapter/",
      "../../../packages/pi-runtime/": "packages/pi-runtime/",
      "../../../.generated/runtime/node_modules/": "node_modules/",
      "../../../.generated/runtime/package.json": "runtime/package.json",
      "../../../.generated/runtime/NODE-LICENSE": "runtime/NODE-LICENSE"
    }
  }
}
