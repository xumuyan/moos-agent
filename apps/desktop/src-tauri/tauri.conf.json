{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moos",
  "version": "0.1.0",
  "identifier": "dev.moos.agent",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Moos", "width": 1280, "height": 820 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": { "minimumSystemVersion": "14.0" },
    "externalBin": ["binaries/node"],
    "resources": {
      "../../../services/agent/": "services/agent/",
      "../../../packages/pi-adapter/": "packages/pi-adapter/",
      "../../../.generated/runtime/node_modules/": "node_modules/",
      "../../../.generated/runtime/package.json": "runtime/package.json",
      "../../../.generated/runtime/NODE-LICENSE": "runtime/NODE-LICENSE"
    }
  }
}
